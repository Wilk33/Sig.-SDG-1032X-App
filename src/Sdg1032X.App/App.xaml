<Application
	x:Class="Sdg1032X.App.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	StartupUri="MainWindow.xaml">
	<Application.Resources>
		<SolidColorBrush x:Key="WindowBrush" Color="#616161" />
		<SolidColorBrush x:Key="PanelBrush" Color="#707070" />
		<SolidColorBrush x:Key="ControlBrush" Color="#919191" />
		<SolidColorBrush x:Key="LightBrush" Color="#E7E7E7" />
		<Style TargetType="Window">
			<Setter Property="Background" Value="{StaticResource WindowBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontFamily" Value="Consolas" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style TargetType="Button">
			<Setter Property="Background" Value="{StaticResource LightBrush}" />
			<Setter Property="Foreground" Value="#222222" />
			<Setter Property="BorderBrush" Value="#B0B0B0" />
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="MinHeight" Value="28" />
		</Style>
		<Style TargetType="RepeatButton">
			<Setter Property="Background" Value="#737373" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderBrush" Value="#B0B0B0" />
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="#919191" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CaretBrush" Value="White" />
			<Setter Property="BorderBrush" Value="#A0A0A0" />
			<Setter Property="SelectionBrush" Value="#0078D4" />
		</Style>
		<Style TargetType="ComboBox">
			<Setter Property="Background" Value="#919191" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderBrush" Value="#A0A0A0" />
			<Setter Property="MinHeight" Value="29" />
		</Style>
		<Style TargetType="GroupBox">
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderBrush" Value="#8A8A8A" />
			<Setter Property="Margin" Value="8,5" />
			<Setter Property="Padding" Value="8,5" />
		</Style>
	</Application.Resources>
</Application>
